{
  "$description": "Althio design tokens in W3C Design Tokens format. Source of record for non-CSS platforms. Import into Figma with the Tokens Studio plugin, or feed to Style Dictionary to generate other outputs. Keep in sync with tokens.css.",
  "color": {
    "paper": {
      "$value": "#FBF7F0",
      "$type": "color",
      "$description": "Page background"
    },
    "ink": {
      "$value": "#23201C",
      "$type": "color",
      "$description": "Primary text, dark UI"
    },
    "ink-72": {
      "$value": "#23201CB8",
      "$type": "color"
    },
    "ink-60": {
      "$value": "#23201C99",
      "$type": "color",
      "$description": "Secondary text; large text only (4.2:1 on paper)"
    },
    "ink-34": {
      "$value": "#23201C57",
      "$type": "color",
      "$description": "Decorative labels only"
    },
    "night": {
      "$value": "#0B0F1E",
      "$type": "color",
      "$description": "Dark-section background"
    },
    "frost": {
      "$value": "#EDF1FA",
      "$type": "color",
      "$description": "Text on dark surfaces"
    },
    "white": {
      "$value": "#FFFFFF",
      "$type": "color"
    },
    "sky": {
      "$value": "#7A9ED0",
      "$type": "color"
    },
    "sky-mid": {
      "$value": "#8FADD6",
      "$type": "color"
    },
    "sky-soft": {
      "$value": "#A8C6E8",
      "$type": "color"
    },
    "lavender": {
      "$value": "#B9B4DE",
      "$type": "color"
    },
    "lavender-mid": {
      "$value": "#ADA5DC",
      "$type": "color"
    },
    "clay": {
      "$value": "#D9A08F",
      "$type": "color"
    },
    "clay-soft": {
      "$value": "#E8B7A6",
      "$type": "color"
    },
    "gold": {
      "$value": "#C9AF7C",
      "$type": "color"
    }
  },
  "semantic": {
    "text-primary": {
      "$value": "{color.ink}",
      "$type": "color"
